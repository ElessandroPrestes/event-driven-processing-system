APP_NAME=eventflow-platform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
DOCKER_UID=1000
DOCKER_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eventflow
DB_USERNAME=eventflow
DB_PASSWORD=secret
DB_SSLMODE=disable
POSTGRES_PORT_FORWARD=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=eventflow-platform

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_FORWARD=6379
REDIS_DB=0
REDIS_CACHE_DB=1

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=eventflow
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=eventflow.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=eventflow.processing
RABBITMQ_INGEST_EXCHANGE=eventflow.events.ingest
RABBITMQ_INGEST_EXCHANGE_TYPE=topic
RABBITMQ_INGEST_QUEUE=eventflow.ingest
RABBITMQ_INGEST_BINDING_KEY=#
RABBITMQ_INGEST_DEAD_LETTER_EXCHANGE=eventflow.events.ingest.dlx
RABBITMQ_INGEST_DEAD_LETTER_EXCHANGE_TYPE=direct
RABBITMQ_INGEST_DEAD_LETTER_QUEUE=eventflow.ingest.dead
RABBITMQ_INGEST_DEAD_LETTER_ROUTING_KEY=eventflow.ingest.dead
RABBITMQ_RETRY_EXCHANGE=eventflow.events.retry
RABBITMQ_RETRY_EXCHANGE_TYPE=direct
RABBITMQ_RETRY_QUEUE=eventflow.processing.retry
RABBITMQ_RETRY_ROUTING_KEY=eventflow.processing.retry
RABBITMQ_RETRY_RETURN_ROUTING_KEY=eventflow.processing.ready
RABBITMQ_DEAD_LETTER_EXCHANGE=eventflow.events.dlx
RABBITMQ_DEAD_LETTER_EXCHANGE_TYPE=direct
RABBITMQ_DEAD_LETTER_QUEUE=eventflow.processing.dead
RABBITMQ_DEAD_LETTER_ROUTING_KEY=eventflow.processing.dead
RABBITMQ_MANAGEMENT_PORT=15672
EVENT_INGEST_API_KEY_HEADER=X-Ingest-Api-Key
EVENT_INGEST_API_KEY=change-me-ingest
EVENT_INGEST_RATE_LIMIT_MAX_ATTEMPTS=60
EVENT_INGEST_RATE_LIMIT_DECAY_SECONDS=60
EVENT_OPERATIONS_API_KEY_HEADER=X-Operations-Api-Key
EVENT_OPERATIONS_API_KEY=change-me-operations
EVENT_OPERATIONS_RATE_LIMIT_MAX_ATTEMPTS=120
EVENT_OPERATIONS_RATE_LIMIT_DECAY_SECONDS=60
EVENT_API_EVENTS_DEFAULT_PER_PAGE=20
EVENT_API_EVENTS_MAX_PER_PAGE=100
EVENT_API_EVENT_HISTORY_DEFAULT_PER_PAGE=20
EVENT_API_EVENT_HISTORY_MAX_PER_PAGE=100
EVENT_TRACE_HEADER=X-Trace-Id
EVENT_CONSUMER_MAX_ATTEMPTS=3
EVENT_CONSUMER_IDLE_TIMEOUT=5
EVENT_CONSUMER_RETRY_BASE_DELAY_MS=5000
EVENT_CONSUMER_RETRY_MULTIPLIER=2
EVENT_CONSUMER_RETRY_MAX_DELAY_MS=60000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
